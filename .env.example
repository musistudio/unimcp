# Vision LLM. The server uses OpenAI-compatible chat/completions.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
VISION_API_KEY=
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-5.5
VISION_TIMEOUT_MS=30000
VISION_MAX_LOCAL_IMAGE_BYTES=20971520

# Search provider. Use one of: brave, bing, google_cse, serper, serpapi, tavily.
SEARCH_PROVIDER=brave
SEARCH_TIMEOUT_MS=30000
SEARCH_RESULT_COUNT=5
BRAVE_SEARCH_API_KEY=
BING_SEARCH_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
SERPER_API_KEY=
SERPAPI_API_KEY=
TAVILY_API_KEY=

# Optional custom endpoints, normally not needed.
BRAVE_SEARCH_ENDPOINT=
BING_SEARCH_ENDPOINT=
GOOGLE_SEARCH_ENDPOINT=
SERPER_SEARCH_ENDPOINT=
SERPAPI_SEARCH_ENDPOINT=
TAVILY_SEARCH_ENDPOINT=
